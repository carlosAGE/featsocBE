# Copy to .env and fill in real values. Never commit .env.
# All values are read only via src/config/env.js.

# --- Server ---
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed origins for CORS (frontend URLs).
# Use * only for local development.
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Local example: mongodb://127.0.0.1:27017/featsoc
# Azure Cosmos DB (Mongo API) / Atlas: paste the full connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/featsoc

# --- Auth ---
# Secret used to sign session JWTs. Generate a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Name of the httpOnly session cookie set on login.
COOKIE_NAME=featsoc_token
# Cross-site cookie settings. For a frontend on a different domain you need
# SameSite=None (which forces Secure=true). For same-site/local dev, "lax".
COOKIE_SAMESITE=lax
# Set the parent domain the cookie is valid for (optional, e.g. .example.com).
COOKIE_DOMAIN=

# --- Google sign-in ---
# OAuth 2.0 Web client ID from Google Cloud Console (Credentials).
# Only the client ID is needed for ID-token verification.
# For native/iOS you may have additional client IDs — add them comma-separated.
GOOGLE_CLIENT_ID=

# --- Video storage (Cloudflare R2) ---
# R2 is S3-compatible. Create the bucket + an API token (Account Home ->
# R2 -> Manage API Tokens) scoped to Object Read & Write on this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=featsoc-videos
# Public URL base videos are served from: either the bucket's r2.dev
# subdomain (enable "Public access" on the bucket) or a custom domain you've
# mapped to it. No trailing slash, e.g. https://videos.example.com
R2_PUBLIC_BASE_URL=
# Reject uploads larger than this (megabytes) before ffmpeg ever runs.
MAX_UPLOAD_MB=200
