# Copy to .env and fill in real values. Never commit .env.
# All values are read only via src/config/env.js.

# --- Server ---
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed origins for CORS (frontend URLs).
# Use * only for local development.
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Local example: mongodb://127.0.0.1:27017/featsoc
# Azure Cosmos DB (Mongo API) / Atlas: paste the full connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/featsoc

# --- Auth (TO BE DECIDED — see CLAUDE.md) ---
# Auth strategy is not yet chosen. These are placeholders only; the auth
# implementation is intentionally left as a stub for the maintainer.
# JWT_SECRET=
# JWT_EXPIRES_IN=7d
